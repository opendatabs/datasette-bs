# Copy to .env and fill in values (never commit .env).
# cp .env.example .env

# GitHub OAuth app for datasette-auth-github (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs Datasette auth cookies; generate a random value, e.g.:
# python -c "import secrets; print(secrets.token_hex(32))"
DATASETTE_SECRET=
